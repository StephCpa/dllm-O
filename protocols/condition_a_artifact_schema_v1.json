{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dataset_id": {"type": "string"},
        "dataset_revision": {"type": "string"},
        "dataset_split": {"type": "string"},
        "row_index": {"type": "integer", "minimum": 0},
        "split_role": {"enum": ["calibration", "heldout"]},
        "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "required": [
        "dataset_id", "dataset_revision", "dataset_split", "row_index",
        "split_role", "prompt_sha256"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"const": "ef_b32"},
        "steps": {"const": 256},
        "generation_length": {"const": 256},
        "block_length": {"const": 32},
        "temperature": {"const": 0.6},
        "cfg_scale": {"const": 0.0},
        "remasking": {"const": "high_entropy"}
      },
      "required": [
        "name", "steps", "generation_length", "block_length",
        "temperature", "cfg_scale", "remasking"
      ]
    },
    "repository_state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirty": {"type": "boolean"}
      },
      "required": ["commit", "dirty"]
    },
    "generation_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": {"const": "condition-a-v1"},
        "run_kind": {"enum": ["condition-a-smoke", "condition-a-formal"]},
        "condition_a_freeze_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "split_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source": {"$ref": "#/$defs/source"},
        "model_id": {"const": "GSAI-ML/LLaDA-8B-Instruct"},
        "model_revision": {
          "const": "08b83a6feb34df1a6011b80c3c00c7563e963b07"
        },
        "policy": {"$ref": "#/$defs/policy"},
        "rollout_index": {"type": "integer", "minimum": 0, "maximum": 63},
        "seed_key": {"type": "string"},
        "seed": {"type": "integer", "minimum": 0},
        "response": {"type": "string"},
        "parsed_answer": {"type": ["string", "null"]},
        "parser_status": {"type": "string"},
        "correct": {"type": "boolean"},
        "wall_time_seconds": {"type": "number", "minimum": 0},
        "peak_memory_bytes": {"type": ["integer", "null"], "minimum": 0},
        "trace_event_count": {"const": 256},
        "trace_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runner_repository": {"$ref": "#/$defs/repository_state"},
        "external_repository_commit": {
          "const": "1a2fddb5c6655597e63081c0af5ebb718a849f39"
        },
        "environment_fingerprint": {"type": "object"},
        "completion_status": {"const": "complete"}
      },
      "required": [
        "protocol_version", "run_kind", "condition_a_freeze_sha256",
        "split_manifest_sha256", "source", "model_id", "model_revision",
        "policy", "rollout_index", "seed_key", "seed", "response",
        "parsed_answer", "parser_status", "correct", "wall_time_seconds",
        "peak_memory_bytes", "trace_event_count", "trace_sha256",
        "runner_repository", "external_repository_commit",
        "environment_fingerprint", "completion_status"
      ]
    },
    "shard_completion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": {"const": "condition-a-v1"},
        "run_kind": {"enum": ["condition-a-smoke", "condition-a-formal"]},
        "task_selection": {"enum": ["all", "gsm8k", "math500"]},
        "shard_index": {"type": "integer", "minimum": 0},
        "num_shards": {"type": "integer", "minimum": 1},
        "expected_keys_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_keys_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "result_count": {"type": "integer", "minimum": 0},
        "completed_at_utc": {"type": "string", "format": "date-time"}
      },
      "required": [
        "protocol_version", "run_kind", "task_selection", "shard_index",
        "num_shards", "expected_keys_sha256", "observed_keys_sha256",
        "result_count", "completed_at_utc"
      ]
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/generation_result"},
    {"$ref": "#/$defs/shard_completion"}
  ]
}
